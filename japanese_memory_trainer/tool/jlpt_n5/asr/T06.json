[
{
"start": 4.54,
"end": 6.24,
"text": "二"
},
{
"start": 7.35,
"end": 11.36,
"text": "二では初めに質問を聞いてください"
},
{
"start": 11.99,
"end": 20.99,
"text": "それから話を聞いて問題用紙の一から四の中から一番いいものを一つ選んでください"
},
{
"start": 26.74,
"end": 27.61,
"text": "一ばん"
},
{
"start": 28.76,
"end": 33.02,
"text": "うちで男の人と女の人が話しています"
},
{
"start": 33.66,
"end": 36.29,
"text": "女の人は何を作りましたか"
},
{
"start": 38.55,
"end": 39.52,
"text": "よ"
},
{
"start": 39.99,
"end": 43.17,
"text": "ごはんを作りましたからリビングに来て下さい"
},
{
"start": 43.93,
"end": 45.18,
"text": "おはようございま"
},
{
"start": 45.91,
"end": 48.32,
"text": "えありがとうござい"
},
{
"start": 49.05,
"end": 51.17,
"text": "朝ご飯ですみません"
},
{
"start": 51.77,
"end": 55.04,
"text": "それからごはんだけです"
},
{
"start": 55.67,
"end": 60.16,
"text": "私はパンよりごはんが好きですからうれしいです"
},
{
"start": 60.79,
"end": 61.69,
"text": "いただきます"
},
{
"start": 62.36,
"end": 63.42,
"text": "どうぞ"
},
{
"start": 69.43,
"end": 72.16,
"text": "女の人は何を作りましたか"
},
{
"start": 88.25,
"end": 88.96,
"text": "二ばん"
},
{
"start": 90.17,
"end": 95.17,
"text": "大学で男の学生と女の学生が話しています"
},
{
"start": 95.83,
"end": 100.57,
"text": "女の学生は一週間に何回ヨガを習いますか"
},
{
"start": 102.65,
"end": 103.55,
"text": "さん"
},
{
"start": 103.99,
"end": 105.31,
"text": "いきま"
},
{
"start": 105.94,
"end": 109.41,
"text": "今からヨガ教室でヨガをします"
},
{
"start": 109.88,
"end": 111.13,
"text": "すごいですね"
},
{
"start": 111.86,
"end": 113.02,
"text": "います"
},
{
"start": 113.75,
"end": 114.14,
"text": "はい"
},
{
"start": 114.78,
"end": 119.33,
"text": "前は土曜日にだけ習っていましたが"
},
{
"start": 119.96,
"end": 123.42,
"text": "今は火曜日と木曜日も習っています"
},
{
"start": 124.44,
"end": 125.44,
"text": "ねえ"
},
{
"start": 126.07,
"end": 127.26,
"text": "頑張ってください"
},
{
"start": 127.93,
"end": 129.25,
"text": "ありがとうござい"
},
{
"start": 135.38,
"end": 140.13,
"text": "女の学生は一週間に何回ヨガを習いますか"
},
{
"start": 156.31,
"end": 157.12,
"text": "③ばん"
},
{
"start": 158.23,
"end": 162.59,
"text": "男の学生がクラスのみんなの前で話しています"
},
{
"start": 163.26,
"end": 166.43,
"text": "男の学生がホームステイしている家には"
},
{
"start": 166.9,
"end": 168.86,
"text": "誰が住んでいますか"
},
{
"start": 171.32,
"end": 173.89,
"text": "ホームステイをしています"
},
{
"start": 174.68,
"end": 178.17,
"text": "そう"
},
{
"start": 178.68,
"end": 181.37,
"text": "そして犬が一匹います"
},
{
"start": 182.26,
"end": 183.58,
"text": "優しいです"
},
{
"start": 184.25,
"end": 187.58,
"text": "ホームステイをしているのは僕だけじゃありません"
},
{
"start": 188.28,
"end": 191.97,
"text": "からきたマイクくんもいっしょに住んでいます"
},
{
"start": 192.79,
"end": 199.93,
"text": "隣の町に住んでいる息子さんの家族が来る時はみんなでパーティーをします"
},
{
"start": 200.79,
"end": 202.08,
"text": "とてもたのしいです"
},
{
"start": 208.28,
"end": 213.95,
"text": "男の学生がホームステイしている家には今誰が住んでいますか"
},
{
"start": 229.94,
"end": 230.81,
"text": "四番"
},
{
"start": 232.38,
"end": 237.09,
"text": "男の学生と女の学生が話しています"
},
{
"start": 237.72,
"end": 241.73,
"text": "男の学生は夏休みに何をしますか"
},
{
"start": 243.86,
"end": 245.92,
"text": "あしたから夏休みですね"
},
{
"start": 246.58,
"end": 246.94,
"text": "はい"
},
{
"start": 247.64,
"end": 250.37,
"text": "私は友達と旅行に行きます"
},
{
"start": 250.97,
"end": 252.22,
"text": "いいですね"
},
{
"start": 252.86,
"end": 254.27,
"text": "泳ぎます"
},
{
"start": 254.84,
"end": 259.39,
"text": "いえうみじゃなくてホテルにあるプールであそびます"
},
{
"start": 260.02,
"end": 261.41,
"text": "すごいですね"
},
{
"start": 262.14,
"end": 264.57,
"text": "林さんは何をします"
},
{
"start": 265.3,
"end": 268.13,
"text": "私は友達とキャンプをします"
},
{
"start": 268.76,
"end": 272.96,
"text": "そのあとみんなでバーベキューをします"
},
{
"start": 279.03,
"end": 282.97,
"text": "男の学生は夏休みに何をしますか"
},
{
"start": 299.16,
"end": 299.84,
"text": "五番"
},
{
"start": 301.05,
"end": 306.3,
"text": "大学の図書館で先生と男の学生が話しています"
},
{
"start": 306.97,
"end": 310.81,
"text": "男の学生は何時間図書館にいますか"
},
{
"start": 312.98,
"end": 316.32,
"text": "一生懸命勉強していますね"
},
{
"start": 317.11,
"end": 319.29,
"text": "何時から勉強しています"
},
{
"start": 320.02,
"end": 324.0,
"text": "二時に図書館に来て勉強を始めました"
},
{
"start": 324.63,
"end": 326.78,
"text": "今何時ですか"
},
{
"start": 327.42,
"end": 328.96,
"text": "六時ですよ"
},
{
"start": 329.56,
"end": 330.21,
"text": "え"
},
{
"start": 330.65,
"end": 332.45,
"text": "そんな時間ですか"
},
{
"start": 333.18,
"end": 335.74,
"text": "図書館は何時までですか"
},
{
"start": 336.38,
"end": 337.57,
"text": "八時までです"
},
{
"start": 344.02,
"end": 347.65,
"text": "生"
},
{
"start": 363.7,
"end": 364.57,
"text": "六ばん"
},
{
"start": 366.1,
"end": 369.25,
"text": "男の人が話しています"
},
{
"start": 369.98,
"end": 373.47,
"text": "ひとはきのうどこへいきましたか"
},
{
"start": 375.74,
"end": 376.57,
"text": "木さん"
},
{
"start": 377.3,
"end": 380.35,
"text": "ひるびじゅつかんにいきましたか"
},
{
"start": 380.95,
"end": 382.94,
"text": "いえ行っていません"
},
{
"start": 383.61,
"end": 385.5,
"text": "そうですか"
},
{
"start": 386.2,
"end": 392.29,
"text": "昨日は父と母とレストランでごはんを食べて家に帰りました"
},
{
"start": 392.82,
"end": 393.89,
"text": "そうですか"
},
{
"start": 394.58,
"end": 404.0,
"text": "デパートを出て駅に行く時に美術館の前にいた人が高木さんだと思いましたが違う人ですね"
},
{
"start": 404.73,
"end": 405.76,
"text": "そうですね"
},
{
"start": 411.86,
"end": 415.55,
"text": "女の人はきのうどこへいきましたか"
}
]