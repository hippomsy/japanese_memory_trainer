[
{
"start": 4.6,
"end": 6.27,
"text": "二"
},
{
"start": 7.42,
"end": 11.49,
"text": "二では初めに質問を聞いてください"
},
{
"start": 12.12,
"end": 17.73,
"text": "それから問題用紙の一から四の中から"
},
{
"start": 18.2,
"end": 21.37,
"text": "いいものを一つえらんでください"
},
{
"start": 27.16,
"end": 28.0,
"text": "一ばん"
},
{
"start": 29.46,
"end": 32.7,
"text": "男の人と女の人が話しています"
},
{
"start": 33.37,
"end": 36.8,
"text": "男の人はどんな部屋に住んでいますか"
},
{
"start": 38.97,
"end": 42.49,
"text": "ジョージさんは日本のテレビをよく見ますか"
},
{
"start": 43.1,
"end": 46.53,
"text": "最近日本に来ましたから"
},
{
"start": 47.0,
"end": 50.08,
"text": "部屋にはまだテレビはありません"
},
{
"start": 50.78,
"end": 51.71,
"text": "そうです"
},
{
"start": 52.38,
"end": 55.71,
"text": "一人でいる時は何をしていますか"
},
{
"start": 56.31,
"end": 57.92,
"text": "本がある"
},
{
"start": 58.36,
"end": 64.38,
"text": "ベッドの上で読んだりつくえで日本語を勉強したりしています"
},
{
"start": 65.02,
"end": 67.04,
"text": "さんは真面目ですね"
},
{
"start": 73.27,
"end": 76.38,
"text": "はい"
},
{
"start": 92.31,
"end": 93.09,
"text": "二ばん"
},
{
"start": 94.2,
"end": 97.63,
"text": "店の人と女の人が話しています"
},
{
"start": 98.26,
"end": 101.89,
"text": "女の人は全部でいくら買いましたか"
},
{
"start": 104.02,
"end": 105.05,
"text": "いらっしゃい"
},
{
"start": 105.66,
"end": 108.13,
"text": "きょうはバナナが安いですよ"
},
{
"start": 108.73,
"end": 109.85,
"text": "です"
},
{
"start": 110.46,
"end": 112.29,
"text": "いつもは三百円ですが"
},
{
"start": 112.82,
"end": 114.21,
"text": "きょうは二百円です"
},
{
"start": 114.84,
"end": 116.41,
"text": "二つください"
},
{
"start": 117.02,
"end": 119.52,
"text": "それからいちごはいくらですか"
},
{
"start": 120.31,
"end": 121.15,
"text": "五百円です"
},
{
"start": 122.17,
"end": 123.26,
"text": "え"
},
{
"start": 123.93,
"end": 125.98,
"text": "多くは要らないし"
},
{
"start": 126.49,
"end": 127.81,
"text": "どうです"
},
{
"start": 128.28,
"end": 129.41,
"text": "三百えんです"
},
{
"start": 130.04,
"end": 132.29,
"text": "それも一つ下さい"
},
{
"start": 138.36,
"end": 141.76,
"text": "女の人は全部でいくら買いましたか"
},
{
"start": 157.85,
"end": 158.72,
"text": "三ばん"
},
{
"start": 159.96,
"end": 164.29,
"text": "台車で男の人と女の人が話しています"
},
{
"start": 164.92,
"end": 168.25,
"text": "女の人は何で会社に来ますか"
},
{
"start": 170.36,
"end": 173.92,
"text": "中野さんの家は会社まで遠いですか"
},
{
"start": 174.58,
"end": 177.66,
"text": "バスで十五分くらいです"
},
{
"start": 178.46,
"end": 179.84,
"text": "いいですね"
},
{
"start": 180.5,
"end": 183.04,
"text": "電車で一じかんかかります"
},
{
"start": 183.7,
"end": 185.44,
"text": "それは大変ですね"
},
{
"start": 186.01,
"end": 188.64,
"text": "私は人が多いのは嫌だから"
},
{
"start": 189.11,
"end": 190.72,
"text": "歩いてきま"
},
{
"start": 191.61,
"end": 194.05,
"text": "方がいいんじゃないですか"
},
{
"start": 194.65,
"end": 197.69,
"text": "車が多いから自転車も危ないです"
},
{
"start": 198.26,
"end": 199.77,
"text": "動にもなりますし"
},
{
"start": 205.78,
"end": 209.34,
"text": "女の人は何で会社に来ますか"
},
{
"start": 225.18,
"end": 226.14,
"text": "四ばん"
},
{
"start": 227.29,
"end": 231.13,
"text": "男の学生と女の学生が話しています"
},
{
"start": 231.77,
"end": 235.2,
"text": "女の学生は今晩何をしますか"
},
{
"start": 235.8,
"end": 237.92,
"text": "きょうは金曜日ですね"
},
{
"start": 238.68,
"end": 241.05,
"text": "あしたは何をするんですか"
},
{
"start": 242.01,
"end": 243.68,
"text": "何もしません"
},
{
"start": 244.25,
"end": 246.17,
"text": "ゆっくり休みます"
},
{
"start": 246.84,
"end": 250.91,
"text": "みんなでカラオケに行く約束をしました"
},
{
"start": 251.58,
"end": 253.53,
"text": "せ"
},
{
"start": 254.42,
"end": 255.33,
"text": "が"
},
{
"start": 255.83,
"end": 258.46,
"text": "今日の夜はアルバイトがありますから"
},
{
"start": 259.29,
"end": 262.17,
"text": "家に帰ってごはんを食べます"
},
{
"start": 262.87,
"end": 264.03,
"text": "そうですか"
},
{
"start": 264.63,
"end": 267.42,
"text": "あしたの夜はどうですか"
},
{
"start": 267.99,
"end": 269.63,
"text": "あしたは大丈夫です"
},
{
"start": 270.26,
"end": 272.61,
"text": "みんなにきいてみます"
},
{
"start": 278.71,
"end": 282.27,
"text": "女の学生は今晩何をしますか"
},
{
"start": 298.1,
"end": 298.85,
"text": "五ばん"
},
{
"start": 300.22,
"end": 303.55,
"text": "男の人と女の人が話しています"
},
{
"start": 304.15,
"end": 308.16,
"text": "女の人は昨日の夜何時間寝ましたか"
},
{
"start": 310.39,
"end": 311.71,
"text": "おはようございま"
},
{
"start": 312.41,
"end": 313.69,
"text": "どうしました"
},
{
"start": 314.42,
"end": 317.05,
"text": "テストの勉強をしましたから"
},
{
"start": 317.53,
"end": 319.07,
"text": "遅く寝ました"
},
{
"start": 319.64,
"end": 322.43,
"text": "四時間か五時間くらいですか"
},
{
"start": 323.0,
"end": 323.81,
"text": "いえいえ"
},
{
"start": 324.28,
"end": 326.11,
"text": "三時間しか寝ていません"
},
{
"start": 326.74,
"end": 327.45,
"text": "え"
},
{
"start": 327.96,
"end": 332.22,
"text": "ここまで電車で一時間くらいですよね"
},
{
"start": 332.86,
"end": 334.85,
"text": "電車の中で寝ました"
},
{
"start": 335.45,
"end": 336.73,
"text": "寝たかったですが"
},
{
"start": 337.21,
"end": 340.03,
"text": "みんなが話してうるさかったですから"
},
{
"start": 340.54,
"end": 341.95,
"text": "ませんでした"
},
{
"start": 347.86,
"end": 352.06,
"text": "女の人は昨日の夜何時間寝ましたか"
},
{
"start": 367.93,
"end": 368.86,
"text": "六ばん"
},
{
"start": 369.98,
"end": 375.26,
"text": "学校で男の学生と女の学生が話しています"
},
{
"start": 375.93,
"end": 378.94,
"text": "男の学生は何を課しますか"
},
{
"start": 381.27,
"end": 382.11,
"text": "齋藤さ"
},
{
"start": 382.62,
"end": 385.47,
"text": "借りた教科書とノートです"
},
{
"start": 386.04,
"end": 387.49,
"text": "ありがとうございました"
},
{
"start": 388.12,
"end": 389.34,
"text": "早いですね"
},
{
"start": 389.94,
"end": 391.52,
"text": "もう使いません"
},
{
"start": 392.02,
"end": 393.76,
"text": "大丈夫です"
},
{
"start": 394.9,
"end": 395.74,
"text": "恩田さん"
},
{
"start": 396.25,
"end": 398.14,
"text": "ペンを持って"
},
{
"start": 398.74,
"end": 401.82,
"text": "じゃなくてえんぴつは持っています"
},
{
"start": 402.36,
"end": 403.49,
"text": "いい"
},
{
"start": 404.47,
"end": 405.34,
"text": "です"
},
{
"start": 405.82,
"end": 406.65,
"text": "いいですよ"
},
{
"start": 407.26,
"end": 407.84,
"text": "どうぞ"
},
{
"start": 414.1,
"end": 416.93,
"text": "学生は何を"
}
]