[
{
"start": 0.63,
"end": 1.79,
"text": "二回"
},
{
"start": 2.39,
"end": 3.77,
"text": "もんだい"
},
{
"start": 9.02,
"end": 10.69,
"text": "一"
},
{
"start": 11.77,
"end": 16.16,
"text": "一では初めに質問を聞いてください"
},
{
"start": 16.76,
"end": 25.69,
"text": "それから話を聞いて問題用紙の一から四の中から一番いいものをひとつ選んでください"
},
{
"start": 31.45,
"end": 32.29,
"text": "一ばん"
},
{
"start": 33.37,
"end": 36.64,
"text": "店の人と男の人が話しています"
},
{
"start": 37.21,
"end": 41.05,
"text": "男の人はどんな携帯電話を買いますか"
},
{
"start": 43.16,
"end": 44.25,
"text": "いらっしゃいませ"
},
{
"start": 44.76,
"end": 46.88,
"text": "どんな携帯電話にします"
},
{
"start": 47.32,
"end": 48.64,
"text": "そうですね"
},
{
"start": 49.21,
"end": 53.82,
"text": "私は映画をよく見ますから大きいほうがいいです"
},
{
"start": 54.39,
"end": 56.41,
"text": "カメラはよく使います"
},
{
"start": 57.11,
"end": 60.19,
"text": "いいカメラのものはちょっと高いですが"
},
{
"start": 60.82,
"end": 62.85,
"text": "写真を撮るのが好きですから"
},
{
"start": 63.38,
"end": 66.21,
"text": "いいカメラがあるものをかいたいですね"
},
{
"start": 66.87,
"end": 68.7,
"text": "これはどうですか"
},
{
"start": 69.27,
"end": 70.37,
"text": "いいですね"
},
{
"start": 70.9,
"end": 71.77,
"text": "これにします"
},
{
"start": 77.78,
"end": 81.69,
"text": "男の人はどんな携帯電話を買いますか"
},
{
"start": 97.66,
"end": 98.46,
"text": "二ばん"
},
{
"start": 99.64,
"end": 104.09,
"text": "台車で男の人と女の人が話しています"
},
{
"start": 104.7,
"end": 108.03,
"text": "女の人はこのあと何をしますか"
},
{
"start": 110.3,
"end": 111.04,
"text": "鈴木さん"
},
{
"start": 111.51,
"end": 113.47,
"text": "いそがしいですか"
},
{
"start": 114.07,
"end": 117.09,
"text": "書いていましたが今終わりました"
},
{
"start": 117.91,
"end": 120.86,
"text": "このてがみをだしてきてください"
},
{
"start": 121.43,
"end": 122.37,
"text": "分かりました"
},
{
"start": 122.9,
"end": 127.77,
"text": "十二じですからお昼ごはんをたべたあとで言ってください"
},
{
"start": 128.38,
"end": 129.57,
"text": "そうします"
},
{
"start": 130.26,
"end": 135.68,
"text": "三じにかいぎがありますからその前に会社に帰ってきてくださいね"
},
{
"start": 136.28,
"end": 136.61,
"text": "はい"
},
{
"start": 142.62,
"end": 146.01,
"text": "女の人はこのあとなにをしますか"
},
{
"start": 162.07,
"end": 162.91,
"text": "③ばん"
},
{
"start": 164.02,
"end": 167.49,
"text": "男の人と女の人が話しています"
},
{
"start": 168.12,
"end": 170.81,
"text": "男の人は何を買いますか"
},
{
"start": 173.02,
"end": 175.45,
"text": "ごはんを作りたいですが"
},
{
"start": 175.9,
"end": 178.59,
"text": "中に何もないですね"
},
{
"start": 179.19,
"end": 181.5,
"text": "でかってきましょう"
},
{
"start": 182.1,
"end": 182.97,
"text": "すみません"
},
{
"start": 183.61,
"end": 187.77,
"text": "トマトを三つと卵をお願いします"
},
{
"start": 188.28,
"end": 189.21,
"text": "分かりました"
},
{
"start": 189.82,
"end": 191.84,
"text": "もう"
},
{
"start": 193.43,
"end": 195.58,
"text": "トマトは二つでいいです"
},
{
"start": 196.09,
"end": 196.41,
"text": "はい"
},
{
"start": 197.05,
"end": 198.53,
"text": "いってきま"
},
{
"start": 204.86,
"end": 207.33,
"text": "は何を買いますか"
},
{
"start": 223.32,
"end": 224.25,
"text": "四ばん"
},
{
"start": 225.46,
"end": 228.99,
"text": "男の人と女の人が話しています"
},
{
"start": 229.62,
"end": 234.33,
"text": "男の人は明日どんなDVDを持ってきますか"
},
{
"start": 236.5,
"end": 240.77,
"text": "パーティーのときみんなで映画を見ませんか"
},
{
"start": 241.37,
"end": 242.62,
"text": "いいですね"
},
{
"start": 243.26,
"end": 247.2,
"text": "私の家にはいろいろなDVDがあるんですが"
},
{
"start": 247.86,
"end": 249.63,
"text": "映画が好きです"
},
{
"start": 250.33,
"end": 252.22,
"text": "映画はどうですか"
},
{
"start": 252.82,
"end": 253.18,
"text": "あ"
},
{
"start": 253.69,
"end": 257.6,
"text": "でも田中さんは怖い映画が嫌いですよ"
},
{
"start": 258.17,
"end": 261.89,
"text": "私はアニメ映画や家族映画が好きです"
},
{
"start": 262.55,
"end": 265.6,
"text": "私は家族映画はちょっと"
},
{
"start": 266.23,
"end": 267.93,
"text": "映画もいいですが"
},
{
"start": 268.47,
"end": 270.4,
"text": "動物の映画はどうです"
},
{
"start": 271.06,
"end": 273.31,
"text": "去年人気があった"
},
{
"start": 273.94,
"end": 276.09,
"text": "それならみんな好きですよね"
},
{
"start": 276.66,
"end": 277.79,
"text": "ましょう"
},
{
"start": 278.36,
"end": 279.29,
"text": "わかりました"
},
{
"start": 279.83,
"end": 282.01,
"text": "あしたはそれをもってきます"
},
{
"start": 288.34,
"end": 292.61,
"text": "こんなDVDを持ってきますか"
},
{
"start": 308.5,
"end": 309.21,
"text": "五番"
},
{
"start": 310.62,
"end": 313.89,
"text": "女の人が話しています"
},
{
"start": 314.49,
"end": 317.18,
"text": "男の人は何時に来ますか"
},
{
"start": 319.32,
"end": 322.81,
"text": "ABC会社の白田です"
},
{
"start": 323.45,
"end": 325.89,
"text": "いいです"
},
{
"start": 326.52,
"end": 329.53,
"text": "今から会議があります"
},
{
"start": 330.2,
"end": 332.0,
"text": "あとはどうですか"
},
{
"start": 332.63,
"end": 334.14,
"text": "四時までです"
},
{
"start": 334.78,
"end": 335.61,
"text": "わかりました"
},
{
"start": 336.22,
"end": 339.13,
"text": "じゃあ四時十分ごろに行きます"
},
{
"start": 339.77,
"end": 340.13,
"text": "あ"
},
{
"start": 340.57,
"end": 344.8,
"text": "そのあと青山さんと話をしなければなりません"
},
{
"start": 345.37,
"end": 349.98,
"text": "会議が終わってから三十分後に来てください"
},
{
"start": 351.19,
"end": 352.06,
"text": "分かりました"
},
{
"start": 358.3,
"end": 360.57,
"text": "はい"
},
{
"start": 376.63,
"end": 377.57,
"text": "六ばん"
},
{
"start": 378.97,
"end": 382.11,
"text": "男の人が話しています"
},
{
"start": 382.68,
"end": 385.79,
"text": "男の人はいつアルバイトをしますか"
},
{
"start": 387.1,
"end": 387.9,
"text": "ん"
},
{
"start": 388.38,
"end": 392.96,
"text": "水曜日と金曜日の昼にしていますが"
},
{
"start": 393.69,
"end": 396.35,
"text": "じゃなくてよるにできますか"
},
{
"start": 396.98,
"end": 399.81,
"text": "午後六時からはどうですか"
},
{
"start": 400.57,
"end": 402.37,
"text": "すみません"
},
{
"start": 402.94,
"end": 404.86,
"text": "水曜日は大丈夫ですが"
},
{
"start": 405.34,
"end": 408.7,
"text": "金曜日は午後七時に授業が終わります"
},
{
"start": 409.3,
"end": 410.27,
"text": "そうですか"
},
{
"start": 410.87,
"end": 413.66,
"text": "でも七時はちょっと遅いですね"
},
{
"start": 414.26,
"end": 419.52,
"text": "金曜日じゃなくて火曜日や木曜日は午後六時からできますか"
},
{
"start": 420.41,
"end": 422.11,
"text": "はい"
},
{
"start": 422.74,
"end": 423.68,
"text": "分かりました"
},
{
"start": 424.28,
"end": 426.17,
"text": "それでお願いします"
},
{
"start": 432.5,
"end": 435.58,
"text": "はい"
},
{
"start": 451.58,
"end": 452.54,
"text": "七番"
},
{
"start": 453.98,
"end": 457.82,
"text": "男の人がカフェで話しています"
},
{
"start": 458.46,
"end": 461.37,
"text": "女の人は何を注文しますか"
},
{
"start": 463.61,
"end": 464.51,
"text": "河村さん"
},
{
"start": 465.02,
"end": 466.37,
"text": "食べます"
},
{
"start": 467.26,
"end": 470.97,
"text": "ハンバーグやカレーライスがおいしいですよ"
},
{
"start": 471.67,
"end": 472.77,
"text": "いいですね"
},
{
"start": 473.37,
"end": 475.39,
"text": "島田さんは何にしますか"
},
{
"start": 476.12,
"end": 478.75,
"text": "昨日はカレーライスを食べましたから"
},
{
"start": 479.29,
"end": 480.86,
"text": "ハンバーグにします"
},
{
"start": 481.56,
"end": 484.29,
"text": "私も同じものにします"
},
{
"start": 485.94,
"end": 488.57,
"text": "このアイスクリームもおいしいですよ"
},
{
"start": 489.18,
"end": 490.91,
"text": "に食べません"
},
{
"start": 491.51,
"end": 495.77,
"text": "今ダイエットをしていますからコーヒーにします"
},
{
"start": 501.85,
"end": 504.86,
"text": "女の人は何を注文しますか"
}
]