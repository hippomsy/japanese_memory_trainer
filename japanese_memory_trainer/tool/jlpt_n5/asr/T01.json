[
{
"start": 0.6,
"end": 1.92,
"text": "一回"
},
{
"start": 2.58,
"end": 4.0,
"text": "もんだい"
},
{
"start": 9.18,
"end": 10.94,
"text": "一"
},
{
"start": 12.02,
"end": 16.61,
"text": "一では初めに質問を聞いてください"
},
{
"start": 17.37,
"end": 23.23,
"text": "それから問題用紙の一から四の中から"
},
{
"start": 23.67,
"end": 26.85,
"text": "いいものをひとつえらんでください"
},
{
"start": 33.11,
"end": 33.95,
"text": "一ばん"
},
{
"start": 35.42,
"end": 40.19,
"text": "で男の人と女の人が話しています"
},
{
"start": 40.98,
"end": 44.29,
"text": "男の人はどの犬を選びますか"
},
{
"start": 46.52,
"end": 48.93,
"text": "犬がたくさんいますね"
},
{
"start": 49.53,
"end": 50.85,
"text": "します"
},
{
"start": 51.54,
"end": 54.46,
"text": "犬はちょっと怖いですから"
},
{
"start": 54.97,
"end": 56.83,
"text": "ほうがいいですね"
},
{
"start": 57.56,
"end": 59.2,
"text": "はい"
},
{
"start": 59.8,
"end": 60.73,
"text": "いいですが"
},
{
"start": 61.69,
"end": 63.04,
"text": "い"
},
{
"start": 63.77,
"end": 67.71,
"text": "犬は部屋を掃除するのが大変です"
},
{
"start": 68.44,
"end": 69.44,
"text": "そうですか"
},
{
"start": 70.17,
"end": 72.41,
"text": "あの犬はどうですか"
},
{
"start": 72.98,
"end": 74.17,
"text": "ですね"
},
{
"start": 74.97,
"end": 76.09,
"text": "にします"
},
{
"start": 82.33,
"end": 85.41,
"text": "はい"
},
{
"start": 101.3,
"end": 102.08,
"text": "二ばん"
},
{
"start": 103.42,
"end": 108.32,
"text": "タクシーの中で男の人と女の人が話しています"
},
{
"start": 108.95,
"end": 111.58,
"text": "女の人はどこで織りますか"
},
{
"start": 113.75,
"end": 114.75,
"text": "ん"
},
{
"start": 115.32,
"end": 120.29,
"text": "まっすぐ行ってあの交差点を左に曲がって下さい"
},
{
"start": 120.95,
"end": 121.31,
"text": "はい"
},
{
"start": 121.82,
"end": 122.78,
"text": "左です"
},
{
"start": 123.45,
"end": 128.0,
"text": "それから右にあるコンビニで右に曲がってください"
},
{
"start": 128.6,
"end": 131.33,
"text": "あのみちは入ることができません"
},
{
"start": 131.93,
"end": 135.68,
"text": "左にある花屋の隣で降ります"
},
{
"start": 136.38,
"end": 137.31,
"text": "分かりました"
},
{
"start": 143.38,
"end": 146.01,
"text": "女の人はどこで織りますか"
},
{
"start": 162.07,
"end": 162.91,
"text": "③ばん"
},
{
"start": 163.96,
"end": 167.49,
"text": "男の人と女の人が話しています"
},
{
"start": 168.06,
"end": 171.84,
"text": "男の人は土曜日何を持ってきますか"
},
{
"start": 173.98,
"end": 177.6,
"text": "土曜日にみんなで海でバーベキューをします"
},
{
"start": 178.26,
"end": 179.93,
"text": "ビンさんもどうですか"
},
{
"start": 180.44,
"end": 181.41,
"text": "いいですね"
},
{
"start": 182.04,
"end": 183.45,
"text": "いきたいです"
},
{
"start": 184.06,
"end": 186.78,
"text": "なにかもっていくものはありますか"
},
{
"start": 187.67,
"end": 189.57,
"text": "私が買っていきます"
},
{
"start": 190.14,
"end": 192.73,
"text": "お願いし"
},
{
"start": 193.27,
"end": 194.72,
"text": "いいですよ"
},
{
"start": 195.32,
"end": 197.12,
"text": "吉田さんには野菜を"
},
{
"start": 197.91,
"end": 201.44,
"text": "はい"
},
{
"start": 201.94,
"end": 202.88,
"text": "そうですか"
},
{
"start": 203.35,
"end": 204.41,
"text": "ですね"
},
{
"start": 205.05,
"end": 206.05,
"text": "そうですね"
},
{
"start": 212.31,
"end": 215.71,
"text": "はい"
},
{
"start": 231.61,
"end": 232.57,
"text": "四ばん"
},
{
"start": 233.62,
"end": 236.32,
"text": "学校で先生が話しています"
},
{
"start": 237.02,
"end": 240.22,
"text": "学生は何日にテストを受けますか"
},
{
"start": 242.42,
"end": 243.07,
"text": "皆さん"
},
{
"start": 243.51,
"end": 247.33,
"text": "あしたから九日まで三日間休みです"
},
{
"start": 247.96,
"end": 254.59,
"text": "来週木曜日まで一週間勉強して次の日にテストを受けます"
},
{
"start": 255.26,
"end": 258.81,
"text": "日もちょっと勉強をしてくださいね"
},
{
"start": 264.82,
"end": 268.09,
"text": "学生は何日にテストを受けますか"
},
{
"start": 284.15,
"end": 284.86,
"text": "五ばん"
},
{
"start": 285.94,
"end": 289.5,
"text": "店の人と男の人が話しています"
},
{
"start": 290.14,
"end": 293.79,
"text": "男の人は何曜日にバイトをしますか"
},
{
"start": 295.9,
"end": 297.57,
"text": "お疲れさまでした"
},
{
"start": 298.14,
"end": 299.1,
"text": "中原さん"
},
{
"start": 299.61,
"end": 302.37,
"text": "来週月曜日時間ありますか"
},
{
"start": 303.03,
"end": 304.03,
"text": "すみません"
},
{
"start": 304.6,
"end": 308.51,
"text": "月曜と火曜は遅くまで授業があります"
},
{
"start": 309.18,
"end": 311.01,
"text": "水曜日は大丈夫です"
},
{
"start": 311.7,
"end": 315.23,
"text": "毎週水曜日は山田さんがやっているから"
},
{
"start": 316.15,
"end": 318.24,
"text": "はい"
},
{
"start": 319.1,
"end": 323.93,
"text": "この日は学校の授業もありませんので朝から大丈夫です"
},
{
"start": 324.6,
"end": 325.89,
"text": "ありがとうございま"
},
{
"start": 326.52,
"end": 328.86,
"text": "その日お願いします"
},
{
"start": 335.16,
"end": 338.56,
"text": "はい"
},
{
"start": 354.52,
"end": 355.49,
"text": "六ばん"
},
{
"start": 356.63,
"end": 361.12,
"text": "学校で先生と女の学生が話しています"
},
{
"start": 361.75,
"end": 365.41,
"text": "女の学生は椅子をいくつ持ってきますか"
},
{
"start": 367.67,
"end": 371.77,
"text": "明日の音楽コンサートの準備ですか"
},
{
"start": 372.47,
"end": 374.56,
"text": "私も何かしましょう"
},
{
"start": 375.19,
"end": 376.93,
"text": "あ山本さん"
},
{
"start": 377.37,
"end": 378.59,
"text": "ありがとうございま"
},
{
"start": 379.29,
"end": 382.37,
"text": "カメラはもうチェックしましたが"
},
{
"start": 383.06,
"end": 387.52,
"text": "私はお客さんが座る椅子を持ってきますね"
},
{
"start": 388.34,
"end": 389.66,
"text": "持ってきます"
},
{
"start": 390.23,
"end": 391.52,
"text": "そうですねえ"
},
{
"start": 392.09,
"end": 394.01,
"text": "先生の椅子が十個"
},
{
"start": 394.49,
"end": 397.12,
"text": "学生が座る椅子を三十個"
},
{
"start": 397.72,
"end": 400.41,
"text": "お"
},
{
"start": 401.02,
"end": 404.13,
"text": "家族が座る椅子も必要ですよね"
},
{
"start": 404.76,
"end": 406.37,
"text": "あそうですね"
},
{
"start": 406.97,
"end": 410.3,
"text": "いすも学生と同じでいいです"
},
{
"start": 411.0,
"end": 411.84,
"text": "分かりました"
},
{
"start": 417.82,
"end": 421.6,
"text": "女の学生は椅子をいくつ持ってきますか"
},
{
"start": 437.62,
"end": 438.56,
"text": "七ばん"
},
{
"start": 439.7,
"end": 443.13,
"text": "男の人と女の人が話しています"
},
{
"start": 444.02,
"end": 447.29,
"text": "はい"
},
{
"start": 449.43,
"end": 452.96,
"text": "エビンさんは土曜日にアメリカに帰りますから"
},
{
"start": 453.5,
"end": 455.61,
"text": "明日が最後に会う日ですよ"
},
{
"start": 456.18,
"end": 457.34,
"text": "そうですね"
},
{
"start": 457.85,
"end": 458.75,
"text": "です"
},
{
"start": 459.35,
"end": 461.5,
"text": "手紙を書きました"
},
{
"start": 462.78,
"end": 463.77,
"text": "です"
},
{
"start": 464.66,
"end": 469.37,
"text": "そうしましょう"
},
{
"start": 469.94,
"end": 471.45,
"text": "買いましょう"
},
{
"start": 472.02,
"end": 472.48,
"text": "いえ"
},
{
"start": 473.05,
"end": 477.12,
"text": "カメラをお願いします"
},
{
"start": 477.75,
"end": 479.65,
"text": "写真を撮りましょう"
},
{
"start": 480.18,
"end": 481.09,
"text": "分かりました"
},
{
"start": 481.69,
"end": 483.55,
"text": "はどうしましょう"
},
{
"start": 484.12,
"end": 488.41,
"text": "崔さんに持ってきて下さいとお願いしましょう"
},
{
"start": 494.62,
"end": 497.89,
"text": "はい"
}
]