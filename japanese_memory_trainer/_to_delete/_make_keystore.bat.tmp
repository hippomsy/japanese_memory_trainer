@echo off
chcp 65001 > nul
cd /d "%~dp0"
echo ============================================
echo  기억 일본어 - 배포용 서명 키 만들기 (한 번만)
echo ============================================
if exist "android\key.properties" (
  echo 이미 서명 키가 있습니다. 새로 만들면 기존 사용자가 업데이트를 못 받으니 만들지 않습니다.
  pause
  exit /b 0
)
set "KEYTOOL="
where keytool > nul 2>&1 && set "KEYTOOL=keytool"
if not defined KEYTOOL if exist "%ProgramFiles%\Android\Android Studio\jbr\bin\keytool.exe" set "KEYTOOL=%ProgramFiles%\Android\Android Studio\jbr\bin\keytool.exe"
if not defined KEYTOOL if exist "%JAVA_HOME%\bin\keytool.exe" set "KEYTOOL=%JAVA_HOME%\bin\keytool.exe"
if not defined KEYTOOL (
  echo keytool을 찾지 못했습니다. Android Studio가 설치되어 있는지 확인해 주세요.
  echo NO_KEYTOOL > _keystore_log.txt
  pause
  exit /b 1
)
echo.
echo 서명 키 비밀번호를 정해 입력하세요 (6자 이상, 절대 잊어버리면 안 됩니다).
set /p "KEYPASS=비밀번호: "
"%KEYTOOL%" -genkeypair -v -keystore "android\app\upload-keystore.jks" -storetype JKS -keyalg RSA -keysize 2048 -validity 10000 -alias upload -storepass "%KEYPASS%" -keypass "%KEYPASS%" -dname "CN=Kioku Japanese, OU=App, O=Kioku, C=KR" > _keystore_log.txt 2>&1
if errorlevel 1 (
  echo 키 생성에 실패했습니다.
  echo FAILED >> _keystore_log.txt
  pause
  exit /b 1
)
(
  echo storePassword=%KEYPASS%
  echo keyPassword=%KEYPASS%
  echo keyAlias=upload
  echo storeFile=upload-keystore.jks
) > "android\key.properties"
echo OK >> _keystore_log.txt
echo.
echo 완료! 아래 두 파일을 USB 등 안전한 곳에 꼭 백업하세요. 잃어버리면 앱 업데이트를 배포할 수 없습니다.
echo   android\app\upload-keystore.jks
echo   android\key.properties
pause
